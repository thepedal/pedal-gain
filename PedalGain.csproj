<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <OutputType>Library</OutputType>

    <!--
      DLL name must contain ".NET" for ReBuzz to recognise it as a managed machine.
      This produces:  Pedal Gain.NET.dll
    -->
    <AssemblyName>Pedal Gain.NET</AssemblyName>
    <RootNamespace>WDE.PedalGain</RootNamespace>

    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!--
      BuzzDir defaults to the standard ReBuzz install location.
      Override on the command line if yours differs:
        dotnet build PedalGain.csproj -c Release /p:BuzzDir="D:\MyReBuzz"
    -->
    <BuzzDir Condition="'$(BuzzDir)' == ''">C:\Program Files\ReBuzz</BuzzDir>
    <OutputPath>$(BuzzDir)\Gear\Effects</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <AssemblyTitle>Pedal Gain</AssemblyTitle>
    <Company>WDE</Company>
    <Product>Pedal Gain</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!--
    ReBuzz managed-machine API DLLs.
    Private=false → they are NOT copied into the output folder
    (ReBuzz already has them at runtime).
  -->
  <ItemGroup>
    <!-- Buzz.MachineInterface: IBuzzMachine, MachineDecl, ParameterDecl, Sample, WorkModes -->
    <Reference Include="ReBuzz">
      <HintPath>$(BuzzDir)\ReBuzz.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- BuzzGUI types used by the managed-machine infrastructure -->
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
